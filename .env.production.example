# =============================================================================
# 生产 Compose（donote.cc 单用户模式）
# 复制为 .env 后填写 ACCESS_PASSWORD；文件权限 600。
# 域名、证书与续期步骤见 docs/operations.md。
# =============================================================================

DOMAIN=donote.cc
NGINX_SERVER_NAME=donote.cc

# 账户模式管理员凭据；真实密码仅填写到本地 .env。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 时区（Compose 内 app 已固定 TZ，这里保留供脚本与备份使用）
TZ=Asia/Shanghai

# 访问密码（必填，无默认值）
ACCESS_PASSWORD=

# 消息保留时长（小时），默认 720 小时 = 30 天
EXPIRE_HOURS=720

# 附件/孤儿文件清理任务执行间隔（分钟）
FILE_CLEANUP_INTERVAL_MINUTES=30

# 历史记录分页大小
MESSAGE_PAGE_SIZE=30

# Socket.IO 连接时同步的历史条数
SOCKET_SYNC_LIMIT=20
