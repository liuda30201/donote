# web-clipboard 环境变量示例
# 复制为 .env 后填入真实值：  cp .env.example .env && chmod 600 .env
#
# 【重要】.env 含访问密码，权限必须是 600，且已被 .gitignore 排除，切勿提交。

# ---------------------------------------------------------------------------
# 访问密码（必填）
# 生成方式：openssl rand -base64 24 | tr -d '/+=' | head -c 32
# 用途：登录本服务的唯一凭据；同时以 base64 形式写入浏览器 Cookie(wc_auth)，
#       由前端写入，反向代理的 auth_request 子请求校验。
# ---------------------------------------------------------------------------
ACCESS_PASSWORD=请替换为强随机密码

# ---------------------------------------------------------------------------
# 消息保留时长（小时），到期由应用自动清理
# 默认 720 小时 = 30 天
# ---------------------------------------------------------------------------
EXPIRE_HOURS=720

# 附件/孤儿文件清理任务执行间隔（分钟）
FILE_CLEANUP_INTERVAL_MINUTES=30

# 历史记录分页大小
MESSAGE_PAGE_SIZE=30

# Socket.IO 连接时同步的历史条数
SOCKET_SYNC_LIMIT=20

# STORAGE_ROOT=/app/data 与 TZ=Asia/Shanghai 由 Compose 固定配置。
