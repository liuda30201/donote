# 本机开发 Compose（MacBook M1 + OrbStack）
# 开发 Compose 不需要域名、SSL 证书或 Nginx；端口只绑定 127.0.0.1。
DEV_PORT=3000
DEV_DATA_DIR=./.dev-data

# 账户模式管理员凭据；真实密码仅填写到本地 .env。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 访问密码（开发必填）
# 仅用于本机开发，不要填写生产密码。
# ---------------------------------------------------------------------------
ACCESS_PASSWORD=请替换为仅用于开发的密码

# ---------------------------------------------------------------------------
# 消息保留时长（小时），到期由应用自动清理
# 默认 720 小时 = 30 天
# ---------------------------------------------------------------------------
EXPIRE_HOURS=720

# 附件/孤儿文件清理任务执行间隔（分钟）
FILE_CLEANUP_INTERVAL_MINUTES=30

# 历史记录分页大小
MESSAGE_PAGE_SIZE=30

# Socket.IO 连接时同步的历史条数
SOCKET_SYNC_LIMIT=20

# STORAGE_ROOT=/app/data 与 TZ=Asia/Shanghai 由 Compose 固定配置。

# Accounts 模式可选邮箱验证码（docker-compose.accounts.yml）
# 未配置时，普通用户仍可选择仅密码或身份验证器；邮箱方式显示不可用。
# 推荐 587 STARTTLS，或 465 + SMTP_SECURE=true。必须使用有效 TLS 证书。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 示例 SMTP_FROM=DoNote <no-reply@example.com>（Compose .env 中含空格时可加引号）
